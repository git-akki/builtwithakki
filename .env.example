# Supabase — frontend (safe to use in browser, prefix with VITE_)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Cal.com booking link — frontend. Optional.
# When unset, the Book Call button falls back to the Google Calendar link.
# Use the full event URL, e.g. https://cal.com/akash/30min
VITE_CAL_LINK=

# Supabase — serverless only (api/contact.js) — NEVER expose in frontend
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend — serverless only
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
TO_EMAIL=you@yourdomain.com

# Gemini — serverless only (api/chat.js) — NEVER expose in frontend
GEMINI_API_KEY=AIza...
